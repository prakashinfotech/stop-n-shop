# Copy this to .env and fill in values before running docker compose up

# SQL Server SA password (min 8 chars, must include upper, lower, digit, symbol)
SA_PASSWORD=YourStr0ng!Pass

# JWT signing secret (at least 32 random characters)
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Twilio (optional — leave blank to disable SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP / email notifications (optional — leave blank to disable outbound email)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=

# UI -> API base URL, baked into the UI image at BUILD time (rebuild the ui image to change it).
#   /api (default)          same-origin; the ui container's nginx proxies /api to the api container
#   https://<api-host>/api  split-host deploy; also set AllowedOrigins on the API to the UI origin
VITE_API_URL=/api

# REQUIRED IN PRODUCTION (docker-compose.prod.yml refuses to start without it).
# The exact public UI origin — scheme included, NO trailing slash, comma-separated
# for more than one. If this does not match the origin in the browser's address bar,
# the browser blocks every API call with a CORS error and the site shows no data.
#   Production: https://stop-n-shop.prakashsoftwares.com
ALLOWED_ORIGINS=http://localhost:3000

# Container registry coordinates, used by docker-compose.prod.yml.
# Leave IMAGE_PREFIX unset to build locally; set it to pull CI-built images instead:
#   IMAGE_PREFIX=ghcr.io/prakashinfotech
# IMAGE_TAG pins a release; `latest` tracks the newest push to master.
IMAGE_PREFIX=
IMAGE_TAG=latest
