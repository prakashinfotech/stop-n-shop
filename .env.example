# Copy this to .env and fill in values before running docker compose up

# SQL Server SA password (min 8 chars, must include upper, lower, digit, symbol)
SA_PASSWORD=YourStr0ng!Pass

# JWT signing secret (at least 32 random characters)
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Twilio (optional — leave blank to disable SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP / email notifications (optional — leave blank to disable outbound email)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
